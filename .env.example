# Database
DATABASE_URL="postgresql://postgres:password@localhost:5433/whatsapp_support_os?schema=public"

# App
PORT=3001
NODE_ENV=development

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Evolution WhatsApp
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=default

# Password reset
JWT_ACCESS_SECRET=CHANGE_THIS_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_SECRET=CHANGE_THIS_SECRET
JWT_RESET_PASSWORD_EXPIRES_IN=30m
RESET_PASSWORD_BASE_URL=http://localhost:3000/reset-password

# SMTP (Gmail example)
# 1) Activate 2-Step Verification in your Google account
# 2) Generate an App Password (Mail)
# 3) Put the 16-char value in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=GMAIL_APP_PASSWORD_16_CHARS
SMTP_FROM="Support Dashboard <your-email@gmail.com>"
