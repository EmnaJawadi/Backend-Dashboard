generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  AGENT
  EMPLOYEE
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
}

enum CompanyRegistrationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum AgentRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELED
}

enum WhatsappConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  CONNECTED
  ERROR
}

enum NotificationPriority {
  low
  medium
  high
}

enum NotificationType {
  COMPANY_REGISTRATION_REQUEST
  AGENT_REGISTRATION_REQUEST
  AI_LOW_CONFIDENCE
  HANDOFF_REQUIRED
  CUSTOMER_REQUEST_HUMAN
  IMPORTANT_VALIDATION
  KB_DRAFT_SUGGESTION
  WHATSAPP_DISCONNECTED
  WHATSAPP_NOT_CONNECTED
  CONVERSATION_FOLLOW_UP
  CONVERSATION_INACTIVE_RISK
}

enum KbArticleStatus {
  draft
  published
  archived
  rejected
}

enum KbArticleSource {
  manual
  human_agent_response
  imported
}

enum KbSuggestionStatus {
  pending
  approved
  rejected
}

model User {
  id                         String                       @id @default(uuid())
  companyId                  String?                      @map("company_id")
  fullName                   String?                      @map("full_name")
  email                      String                       @unique
  passwordHash               String                       @map("password_hash")
  role                       UserRole                     @default(AGENT)
  isActive                   Boolean                      @default(true) @map("is_active")
  approvalStatus             UserApprovalStatus           @default(APPROVED) @map("approval_status")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  company                    Company?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  auditLogs                  AuditLog[]                   @relation("AuditLogActor")
  reviewedRegistrations      CompanyRegistrationRequest[] @relation("RegistrationReviewedBy")
  reviewedAgentRegistrations AgentRegistrationRequest[]   @relation("AgentRegistrationReviewedBy")
  approvedAgentRegistration  AgentRegistrationRequest?    @relation("AgentRegistrationApprovedUser")
  agentRegistrationRequests  AgentRegistrationRequest[]   @relation("AgentRegistrationUser")
  createdKbArticles          KbArticle[]                  @relation("KbArticleCreator")
  createdKbSuggestions       KbSuggestion[]               @relation("KbSuggestionCreatedBy")
  reviewedKbSuggestions      KbSuggestion[]               @relation("KbSuggestionReviewedBy")
  readNotifications          Notification[]               @relation("NotificationReadBy")

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Company {
  id                           String                       @id @default(uuid())
  name                         String                       @unique
  legalName                    String?                      @map("legal_name")
  email                        String?                      @unique
  phone                        String?
  website                      String?
  address                      String?
  emailNotificationsEnabled    Boolean                      @default(false) @map("email_notifications_enabled")
  status                       CompanyStatus                @default(PENDING)
  isActive                     Boolean                      @default(false) @map("is_active")
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")
  users                        User[]
  subscriptions                Subscription[]
  contacts                     Contact[]
  contactNotes                 ContactNote[]
  conversations                Conversation[]
  conversationTags             ConversationTag[]
  messages                     Message[]
  aiRuns                       AiRun[]
  auditLogs                    AuditLog[]
  kbArticles                   KbArticle[]
  kbChunks                     KbChunk[]
  kbSuggestions                KbSuggestion[]
  settings                     Setting[]
  webhookEvents                WebhookEvent[]
  notifications                Notification[]
  whatsappInstances            CompanyWhatsappInstance[]
  products                     Product[]
  approvedRegistrationRequests CompanyRegistrationRequest[] @relation("ApprovedCompanyRegistration")
  agentRegistrationRequests    AgentRegistrationRequest[]

  @@map("companies")
}

model CompanyRegistrationRequest {
  id                  String                    @id @default(uuid())
  companyName         String                    @map("company_name")
  businessEmail       String                    @map("business_email")
  phoneNumber         String                    @map("phone_number")
  responsibleFullName String                    @map("responsible_full_name")
  requestedRole       UserRole                  @default(COMPANY_ADMIN) @map("requested_role")
  businessType        String                    @map("business_type")
  message             String?
  status              CompanyRegistrationStatus @default(PENDING_APPROVAL)
  rejectionReason     String?                   @map("rejection_reason")
  infoRequest         String?                   @map("info_request")
  reviewedByUserId    String?                   @map("reviewed_by_user_id")
  approvedCompanyId   String?                   @map("approved_company_id")
  approvedAt          DateTime?                 @map("approved_at")
  reviewedAt          DateTime?                 @map("reviewed_at")
  activationToken     String?                   @unique @map("activation_token")
  activationExpiresAt DateTime?                 @map("activation_expires_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  reviewedByUser      User?                     @relation("RegistrationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedCompany     Company?                  @relation("ApprovedCompanyRegistration", fields: [approvedCompanyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([businessEmail])
  @@index([createdAt])
  @@map("company_registration_requests")
}

model AgentRegistrationRequest {
  id               String                  @id @default(uuid())
  companyId        String                  @map("company_id")
  userId           String?                 @map("user_id")
  fullName         String                  @map("full_name")
  email            String
  passwordHash     String                  @map("password_hash")
  status           AgentRegistrationStatus @default(PENDING)
  rejectionReason  String?                 @map("rejection_reason")
  reviewedByUserId String?                 @map("reviewed_by_user_id")
  approvedUserId   String?                 @unique @map("approved_user_id")
  approvedAt       DateTime?               @map("approved_at")
  reviewedAt       DateTime?               @map("reviewed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User?                   @relation("AgentRegistrationUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedByUser   User?                   @relation("AgentRegistrationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedUser     User?                   @relation("AgentRegistrationApprovedUser", fields: [approvedUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("agent_registration_requests")
}

model CompanyWhatsappInstance {
  id                    String                   @id @default(uuid())
  companyId             String                   @map("company_id")
  evolutionInstanceName String                   @unique @map("evolution_instance_name")
  whatsappNumber        String?                  @map("whatsapp_number")
  displayName           String?                  @map("display_name")
  phoneNumberId         String?                  @map("phone_number_id")
  businessAccountId     String?                  @map("business_account_id")
  apiBaseUrl            String?                  @map("api_base_url")
  apiKey                String?                  @map("api_key")
  connectionStatus      WhatsappConnectionStatus @default(DISCONNECTED) @map("connection_status")
  lastConnectionError   String?                  @map("last_connection_error")
  connectedAt           DateTime?                @map("connected_at")
  lastSyncAt            DateTime?                @map("last_sync_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([connectionStatus])
  @@map("company_whatsapp_instances")
}

model Product {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  name        String
  description String?
  category    String?
  price       Float?
  currency    String         @default("TND")
  isAvailable Boolean        @default(true) @map("is_available")
  status      String         @default("ACTIVE")
  keywords    String[]       @default([])
  variants    Json?
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  images      ProductImage[]
  aiRuns      AiRun[]        @relation("AiRunMatchedProduct")

  @@index([companyId])
  @@index([companyId, status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String             @map("company_id")
  plan      String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @map("start_date")
  endDate   DateTime?          @map("end_date")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

model Contact {
  id             String         @id @default(uuid())
  companyId      String?        @map("company_id")
  phone          String?
  whatsappName   String?        @map("whatsapp_name")
  fullName       String?        @map("full_name")
  email          String?
  language       String?
  city           String?
  country        String?
  tags           Json?
  notes          String?
  segment        String?
  source         String?
  status         String?
  lastSeen       DateTime?      @map("last_seen")
  createdAt      DateTime       @map("created_at")
  updatedAt      DateTime       @map("updated_at")
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notesRel       ContactNote[]
  conversations  Conversation[]
  notifications  Notification[]
  sourceArticles KbArticle[]    @relation("KbArticleSourceContact")
  aiRuns         AiRun[]

  @@index([companyId])
  @@index([phone])
  @@map("contacts")
}

model ContactNote {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  contactId String   @map("contact_id")
  authorId  String   @map("author_id")
  note      String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact   Contact  @relation(fields: [contactId], references: [id])

  @@index([companyId])
  @@map("contact_notes")
}

model Conversation {
  id                      String            @id @default(uuid())
  companyId               String?           @map("company_id")
  contactId               String            @map("contact_id")
  channel                 String?
  status                  String?
  priority                String?
  assignedTo              String?           @map("assigned_to")
  botPaused               Boolean?          @map("bot_paused")
  handoffRequired         Boolean?          @map("handoff_required")
  unreadCount             Int?              @map("unread_count")
  lastMessageAt           DateTime?         @map("last_message_at")
  lastCustomerMessageAt   DateTime?         @map("last_customer_message_at")
  lastBotMessageAt        DateTime?         @map("last_bot_message_at")
  lastHumanMessageAt      DateTime?         @map("last_human_message_at")
  conversationSummary     String?           @map("conversation_summary")
  customerIntent          String?           @map("customer_intent")
  requestedProductService String?           @map("requested_product_service")
  requestedDeliveryDate   String?           @map("requested_delivery_date")
  deliveryAddress         String?           @map("delivery_address")
  budget                  String?
  agreedTerms             String?           @map("agreed_terms")
  nextAction              String?           @map("next_action")
  lastAiDecision          String?           @map("last_ai_decision")
  importantNotes          String?           @map("important_notes")
  closedAt                DateTime?         @map("closed_at")
  createdAt               DateTime          @map("created_at")
  updatedAt               DateTime          @map("updated_at")
  company                 Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact                 Contact           @relation(fields: [contactId], references: [id])
  tags                    ConversationTag[]
  messages                Message[]
  notifications           Notification[]
  sourceArticles          KbArticle[]       @relation("KbArticleSourceConversation")
  kbSuggestions           KbSuggestion[]
  aiRuns                  AiRun[]

  @@index([companyId])
  @@index([contactId])
  @@map("conversations")
}

model ConversationTag {
  id             String       @id @default(uuid())
  companyId      String?      @map("company_id")
  conversationId String       @map("conversation_id")
  tag            String
  createdAt      DateTime     @map("created_at")
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, tag])
  @@index([companyId])
  @@map("conversation_tags")
}

model Message {
  id                     String         @id @default(uuid())
  companyId              String?        @map("company_id")
  conversationId         String         @map("conversation_id")
  externalMessageId      String?        @map("external_message_id")
  direction              String?
  senderType             String?        @map("sender_type")
  content                String?
  messageType            String?        @map("message_type")
  caption                String?
  mediaId                String?        @map("media_id")
  mediaUrl               String?        @map("media_url")
  mimeType               String?        @map("mime_type")
  rawPayload             Json?          @map("raw_payload")
  deliveryStatus         String?        @map("delivery_status")
  errorMessage           String?        @map("error_message")
  createdAt              DateTime       @map("created_at")
  messageTimestamp       DateTime?      @map("message_timestamp")
  company                Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversation           Conversation   @relation(fields: [conversationId], references: [id])
  customerSuggestions    KbSuggestion[] @relation("KbSuggestionCustomerMessage")
  humanAnswerSuggestions KbSuggestion[] @relation("KbSuggestionHumanAnswerMessage")

  @@index([companyId])
  @@index([conversationId])
  @@index([externalMessageId])
  @@map("messages")
}

model KbSuggestion {
  id                   String             @id @default(uuid())
  companyId            String?            @map("company_id")
  conversationId       String             @map("conversation_id")
  customerMessageId    String             @map("customer_message_id")
  humanAnswerMessageId String             @map("human_answer_message_id")
  question             String
  answer               String
  status               KbSuggestionStatus @default(pending)
  reviewedBy           String?            @map("reviewed_by")
  createdBy            String?            @map("created_by")
  createdAt            DateTime           @default(now()) @map("created_at")
  reviewedAt           DateTime?          @map("reviewed_at")
  company              Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversation         Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerMessage      Message            @relation("KbSuggestionCustomerMessage", fields: [customerMessageId], references: [id], onDelete: Cascade)
  humanAnswerMessage   Message            @relation("KbSuggestionHumanAnswerMessage", fields: [humanAnswerMessageId], references: [id], onDelete: Cascade)
  createdByUser        User?              @relation("KbSuggestionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  reviewedByUser       User?              @relation("KbSuggestionReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([conversationId])
  @@index([status])
  @@index([customerMessageId])
  @@index([humanAnswerMessageId])
  @@map("kb_suggestions")
}

model AiRun {
  id                     String       @id @default(uuid())
  companyId              String?      @map("company_id")
  conversationId         String       @map("conversation_id")
  messageId              String       @map("message_id")
  contactId              String?      @map("contact_id")
  inputText              String?      @map("input_text")
  inputType              String?      @map("input_type")
  normalizedMessage      String?      @map("normalized_message")
  detectedLanguage       String?      @map("detected_language")
  outputText             String?      @map("output_text")
  intent                 String?
  provider               String?
  model                  String?
  errorMessage           String?      @map("error_message")
  fallbackUsed           Boolean?     @map("fallback_used")
  responseMode           String?      @map("response_mode")
  needsRag               Boolean?     @map("needs_rag")
  ragSources             Json?        @map("rag_sources")
  canAnswer              Boolean?     @map("can_answer")
  orderIntent            Boolean?     @map("order_intent")
  usedKb                 Boolean?     @map("used_kb")
  sourceArticleIds       Json?        @map("source_article_ids")
  sourceChunkIds         Json?        @map("source_chunk_ids")
  retrievedChunksPreview Json?        @map("retrieved_chunks_preview")
  status                 String?
  reason                 String?
  shouldSendMessage      Boolean?     @map("should_send_message")
  imageAnalysisResult    Json?        @map("image_analysis_result")
  matchedProductId       String?      @map("matched_product_id")
  promptTokens           Int?         @map("prompt_tokens")
  completionTokens       Int?         @map("completion_tokens")
  totalTokens            Int?         @map("total_tokens")
  latencyMs              Int?         @map("latency_ms")
  confidenceScore        Float?       @map("confidence_score")
  blockedReason          String?      @map("blocked_reason")
  handoffRequired        Boolean?     @map("handoff_required")
  tagsToApply            Json?        @map("tags_to_apply")
  rawResponse            Json?        @map("raw_response")
  createdAt              DateTime     @map("created_at")
  company                Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact                Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  matchedProduct         Product?     @relation("AiRunMatchedProduct", fields: [matchedProductId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([conversationId])
  @@index([contactId])
  @@index([matchedProductId])
  @@index([responseMode])
  @@index([usedKb])
  @@index([needsRag])
  @@index([orderIntent])
  @@index([fallbackUsed])
  @@map("ai_runs")
}

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  actorUserId String?  @map("actor_user_id")
  action      String?
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @map("created_at")
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorUserId])
  @@index([entityType])
  @@map("audit_logs")
}

model KbArticle {
  id                   String          @id @default(uuid())
  companyId            String?         @map("company_id")
  title                String?
  body                 String?
  category             String?
  tags                 Json?
  language             String?         @map("language")
  status               KbArticleStatus @default(draft)
  source               KbArticleSource @default(manual)
  sourceUrl            String?         @map("source_url")
  sourceConversationId String?         @map("source_conversation_id")
  sourceContactId      String?         @map("source_contact_id")
  createdBy            String?         @map("created_by")
  publishedAt          DateTime?       @map("published_at")
  createdAt            DateTime        @map("created_at")
  updatedAt            DateTime        @map("updated_at")
  company              Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  chunks               KbChunk[]
  sourceConversation   Conversation?   @relation("KbArticleSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceContact        Contact?        @relation("KbArticleSourceContact", fields: [sourceContactId], references: [id], onDelete: SetNull)
  creator              User?           @relation("KbArticleCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([source])
  @@map("kb_articles")
}

model KbChunk {
  id               String                 @id @default(uuid())
  companyId        String?                @map("company_id")
  articleId        String                 @map("article_id")
  chunkIndex       Int                    @map("chunk_index")
  chunkText        String?                @map("chunk_text")
  embeddingsVector Unsupported("vector")? @map("embedding_vector")
  metadataJson     Json?                  @map("metadata_json")
  createdAt        DateTime               @map("created_at")
  article          KbArticle              @relation(fields: [articleId], references: [id])
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("kb_chunks")
}

model Notification {
  id             String               @id @default(uuid())
  companyId      String?              @map("company_id")
  conversationId String?              @map("conversation_id")
  contactId      String?              @map("contact_id")
  readByUserId   String?              @map("read_by_user_id")
  type           NotificationType
  title          String
  message        String
  priority       NotificationPriority @default(medium)
  isRead         Boolean              @default(false) @map("is_read")
  readAt         DateTime?            @map("read_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact        Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  readByUser     User?                @relation("NotificationReadBy", fields: [readByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model Setting {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  key         String   @unique
  value       Json?
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("settings")
}

model WebhookEvent {
  id               String    @id @default(uuid())
  companyId        String?   @map("company_id")
  provider         String?
  eventType        String?   @map("event_type")
  instanceName     String?   @map("instance_name")
  externalEventId  String?   @map("external_event_id")
  payload          Json?
  processingStatus String?   @map("processing_status")
  errorMessage     String?   @map("error_message")
  receivedAt       DateTime  @map("received_at")
  processedAt      DateTime? @map("processed_at")
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([instanceName])
  @@map("webhook_events")
}
