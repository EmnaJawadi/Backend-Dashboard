generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  AGENT
  EMPLOYEE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELED
}

model User {
  id           String   @id @default(uuid())
  companyId    String?  @map("company_id")
  fullName     String?  @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[] @relation("AuditLogActor")

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Company {
  id        String        @id @default(uuid())
  name      String        @unique
  legalName String?       @map("legal_name")
  email     String?
  phone     String?
  website   String?
  address   String?
  status    CompanyStatus @default(ACTIVE)
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  users         User[]
  subscriptions Subscription[]

  @@map("companies")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String             @map("company_id")
  plan      String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @map("start_date")
  endDate   DateTime?          @map("end_date")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

model Contact {
  id           String    @id @default(uuid())
  phone        String?
  whatsappName String?   @map("whatsapp_name")
  fullName     String?   @map("full_name")
  email        String?
  language     String?
  city         String?
  country      String?
  tags         Json?
  notes        String?
  segment      String?
  source       String?
  status       String?
  lastSeen     DateTime? @map("last_seen")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")

  notesRel      ContactNote[]
  conversations Conversation[]

  @@map("contacts")
}

model ContactNote {
  id        String   @id @default(uuid())
  contactId String   @map("contact_id")
  authorId  String   @map("author_id")
  note      String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id])

  @@map("contact_notes")
}

model Conversation {
  id                    String    @id @default(uuid())
  contactId             String    @map("contact_id")
  channel               String?
  status                String?
  priority              String?
  assignedTo            String?   @map("assigned_to")
  botPaused             Boolean?  @map("bot_paused")
  handoffRequired       Boolean?  @map("handoff_required")
  unreadCount           Int?      @map("unread_count")
  lastMessageAt         DateTime? @map("last_message_at")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  lastBotMessageAt      DateTime? @map("last_bot_message_at")
  lastHumanMessageAt    DateTime? @map("last_human_message_at")
  closedAt              DateTime? @map("closed_at")
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  contact  Contact           @relation(fields: [contactId], references: [id])
  tags     ConversationTag[]
  messages Message[]

  @@map("conversations")
}

model ConversationTag {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  tag            String
  createdAt      DateTime @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("conversation_tags")
}

model Message {
  id                String    @id @default(uuid())
  conversationId    String    @map("conversation_id")
  externalMessageId String?   @map("external_message_id")
  direction         String?
  senderType        String?   @map("sender_type")
  content           String?
  messageType       String?   @map("message_type")
  mediaUrl          String?   @map("media_url")
  mimeType          String?   @map("mime_type")
  rawPayload        Json?     @map("raw_payload")
  deliveryStatus    String?   @map("delivery_status")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @map("created_at")
  messageTimestamp  DateTime? @map("message_timestamp")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("messages")
}

model AiRun {
  id               String   @id @default(uuid())
  conversationId   String   @map("conversation_id")
  messageId        String   @map("message_id")
  inputText        String?  @map("input_text")
  outputText       String?  @map("output_text")
  intent           String?
  model            String?
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  latencyMs        Int?     @map("latency_ms")
  handoffRequired  Boolean? @map("handoff_required")
  tagsToApply      Json?    @map("tags_to_apply")
  rawResponse      Json?    @map("raw_response")
  createdAt        DateTime @map("created_at")

  @@map("ai_runs")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String?
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @map("created_at")

  actorUser User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType])
  @@map("audit_logs")
}

model KbArticle {
  id          String    @id @default(uuid())
  title       String?
  body        String?
  category    String?
  tags        Json?
  lang        String?
  status      String?
  version     Int?
  sourceTypes String?   @map("source_type")
  sourceUrl   String?   @map("source_url")
  authorId    String?   @map("author_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")

  chunks KbChunk[]

  @@map("kb_articles")
}

model KbChunk {
  id               String   @id @default(uuid())
  articleId        String   @map("article_id")
  chunkIndex       Int      @map("chunk_index")
  chunkText        String?  @map("chunk_text")
  embeddingsVector Unsupported("vector")? @map("embedding_vector")
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @map("created_at")

  article KbArticle @relation(fields: [articleId], references: [id])

  @@map("kb_chunks")
}

model MessageTemplate {
  id                 String   @id @default(uuid())
  name               String?
  language           String?
  category           String?
  templateBody       String?  @map("template_body")
  providerTemplateId String?  @map("provider_template_id")
  status             String?
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")

  @@map("message_templates")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json?
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("settings")
}

model WebhookEvent {
  id               String    @id @default(uuid())
  provider         String?
  eventType        String?   @map("event_type")
  externalEventId  String?   @map("external_event_id")
  payload          Json?
  processingStatus String?   @map("processing_status")
  errorMessage     String?   @map("error_message")
  receivedAt       DateTime  @map("received_at")
  processedAt      DateTime? @map("processed_at")

  @@map("webhook_events")
}
