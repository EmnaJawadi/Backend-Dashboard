{
  "info": {
    "name": "WhatsApp AI Support — Tests Complets",
    "description": "Collection Postman complète pour tester le système multi-entreprise WhatsApp AI (Toskana World + Flavo Nation). Inclut : IA, RAG, KB, handoff, multi-langue, sécurité.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "pfe-whatsapp-ai"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3000", "type": "string" },
    { "key": "JWT_TOKEN", "value": "", "type": "string", "description": "Rempli automatiquement par la requête Login" },
    { "key": "API_KEY", "value": "your-api-key-here", "type": "string", "description": "Clé API pour /ai/workflow/reply" },
    { "key": "TOSKANA_COMPANY_ID", "value": "", "type": "string", "description": "ID de la company ToskanaWorld (récupéré après login admin)" },
    { "key": "FLAVO_COMPANY_ID", "value": "", "type": "string", "description": "ID de la company FlavoNation (récupéré après login admin)" },
    { "key": "TOSKANA_CONVERSATION_ID", "value": "", "type": "string", "description": "ID d'une conversation ToskanaWorld active" },
    { "key": "FLAVO_CONVERSATION_ID", "value": "", "type": "string", "description": "ID d'une conversation FlavoNation active" },
    { "key": "TOSKANA_CONTACT_ID", "value": "", "type": "string", "description": "ID contact ToskanaWorld" },
    { "key": "FLAVO_CONTACT_ID", "value": "", "type": "string", "description": "ID contact FlavoNation" },
    { "key": "KB_ARTICLE_ID", "value": "", "type": "string", "description": "ID d'un article KB (rempli après création)" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{JWT_TOKEN}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.environment.set('JWT_TOKEN', json.accessToken);",
                  "else if (json.user) pm.test('Login OK - cookie mode', () => pm.response.to.have.status(200));",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@toskanaworld.tn\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{BASE_URL}}/auth/login",
            "description": "Connexion admin. Le JWT est enregistré automatiquement dans la variable JWT_TOKEN."
          }
        },
        {
          "name": "Login Agent FlavoNation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@flavonation.tn\",\n  \"password\": \"Agent123!\"\n}"
            },
            "url": "{{BASE_URL}}/auth/login",
            "description": "Connexion d'un agent FlavoNation pour tester la séparation multi-entreprise."
          }
        }
      ]
    },
    {
      "name": "2. IA — Réponses simples et sociales",
      "item": [
        {
          "name": "Message simple Bonjour (FR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 201', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('IA répond sans RAG pour message social', () => {",
                  "  pm.expect(json.needsRag).to.be.false;",
                  "  pm.expect(json.handoffRequired).to.be.false;",
                  "  pm.expect(json.reply).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Bonjour !\",\n  \"conversationId\": \"{{TOSKANA_CONVERSATION_ID}}\",\n  \"companyId\": \"{{TOSKANA_COMPANY_ID}}\",\n  \"contactId\": \"{{TOSKANA_CONTACT_ID}}\",\n  \"instanceName\": \"toskana-whatsapp-instance\",\n  \"messageId\": \"msg-test-001\",\n  \"phoneNumber\": \"+21655000001\",\n  \"messageType\": \"text\",\n  \"hasMedia\": false,\n  \"direction\": \"inbound\",\n  \"rawPayload\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/ai/reply",
            "description": "Message social pur. L'IA doit répondre sans appeler le RAG. needsRag=false, handoffRequired=false."
          }
        },
        {
          "name": "Message Arabizi (nheb = je veux)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Langue détectée Arabizi', () => {",
                  "  pm.expect(json.detectedLanguage).to.include('tunisian_arabic_latin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Aaslama, nheb na3ref les prix mte3kom\",\n  \"conversationId\": \"{{FLAVO_CONVERSATION_ID}}\",\n  \"companyId\": \"{{FLAVO_COMPANY_ID}}\",\n  \"contactId\": \"{{FLAVO_CONTACT_ID}}\",\n  \"instanceName\": \"flavo-whatsapp-instance\",\n  \"messageId\": \"msg-test-002\",\n  \"phoneNumber\": \"+21655000002\",\n  \"messageType\": \"text\",\n  \"hasMedia\": false,\n  \"direction\": \"inbound\",\n  \"rawPayload\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/ai/reply",
            "description": "Message en Arabizi. L'IA doit détecter la langue et répondre en Arabizi."
          }
        },
        {
          "name": "Message en arabe (Arabic script)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"شنوة الخدمات الموجودة؟\",\n  \"conversationId\": \"{{TOSKANA_CONVERSATION_ID}}\",\n  \"companyId\": \"{{TOSKANA_COMPANY_ID}}\",\n  \"contactId\": \"{{TOSKANA_CONTACT_ID}}\",\n  \"instanceName\": \"toskana-whatsapp-instance\",\n  \"messageId\": \"msg-test-003\",\n  \"phoneNumber\": \"+21655000003\",\n  \"messageType\": \"text\",\n  \"hasMedia\": false,\n  \"direction\": \"inbound\",\n  \"rawPayload\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/ai/reply",
            "description": "Question en arabe sur les services. L'IA doit répondre en arabe depuis la KB ToskanaWorld."
          }
        }
      ]
    },
    {
      "name": "3. IA — Questions métier ToskanaWorld (RAG)",
      "item": [
        {
          "name": "Tarifs hôtel ToskanaWorld (FR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('RAG utilisé pour question prix', () => {",
                  "  pm.expect(json.needsRag).to.be.true;",
                  "});",
                  "pm.test('Réponse contient un tarif en TND', () => {",
                  "  pm.expect(json.reply).to.match(/TND|tarif|prix/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Quels sont les tarifs de l'hôtel en juillet ?\",\n  \"conversationId\": \"{{TOSKANA_CONVERSATION_ID}}\",\n  \"companyId\": \"{{TOSKANA_COMPANY_ID}}\",\n  \"contactId\": \"{{TOSKANA_CONTACT_ID}}\",\n  \"instanceName\": \"toskana-whatsapp-instance\",\n  \"messageId\": \"msg-test-004\",\n  \"phoneNumber\": \"+21655000001\",\n  \"messageType\": \"text\",\n  \"hasMedia\": false,\n  \"direction\": \"inbound\",\n  \"rawPayload\": {}\n}",
