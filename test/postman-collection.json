    {
      "name": "5. Handoff humain",
      "item": [
        {
          "name": "Client insatisfait — Frustration FR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('handoffRequired=true pour frustration', () => {",
                  "  pm.expect(json.handoffRequired).to.be.true;",
                  "});",
                  "pm.test('shouldSendMessage=true — message de transfert envoyé', () => {",
                  "  pm.expect(json.shouldSendMessage).to.be.true;",
                  "  pm.expect(json.reply).to.not.be.empty;",
                  "});",
                  "pm.test('reason indique frustration ou human request', () => {",
                  "  pm.expect(json.reason).to.match(/frustration|human|explicit/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Je suis pas content du tout avec votre service, c'est scandaleux !\",\n  \"conversationId\": \"{{FLAVO_CONVERSATION_ID}}\",\n  \"companyId\": \"{{FLAVO_COMPANY_ID}}\",\n  \"contactId\": \"{{FLAVO_CONTACT_ID}}\",\n  \"instanceName\": \"flavo-whatsapp-instance\",\n  \"messageId\": \"msg-test-020\",\n  \"phoneNumber\": \"+21655000002\",\n  \"messageType\": \"text\",\n  \"hasMedia\": false,\n  \"direction\": \"inbound\",\n  \"rawPayload\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/ai/reply",
            "description": "Client très insatisfait. L'IA doit détecter la frustration et activer le handoff immédiatement avec un message de transfert poli."
          }
        },
